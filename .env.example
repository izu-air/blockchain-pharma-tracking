# =============================================================================
# PharmaChain Trace — environment template
# Copy to `.env` and fill real values.  Do NOT commit `.env`.
# =============================================================================

# ---- PostgreSQL (docker-compose internal network) ---------------------------
POSTGRES_DB=pharma_chain
POSTGRES_USER=postgres
# REQUIRED — set a strong random password before running `docker compose up`.
# docker-compose treats this as ${POSTGRES_PASSWORD:?error} so the stack
# refuses to start without it.  For local-only `mvn spring-boot:run` the
# fallback in application.yml is `postgres` (matches docs/local-setup.md).
POSTGRES_PASSWORD=change-me-before-compose-up

# Used by Spring Boot when running outside compose.  Local-dev default
# matches docs/local-setup.md: postgres / postgres.
DB_URL=jdbc:postgresql://localhost:5432/pharma_chain
DB_USER=postgres
DB_PASSWORD=postgres

# ---- Backend (Spring Boot) --------------------------------------------------
# REQUIRED — HMAC-SHA256 secret, MUST be at least 32 random characters.
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-32+-random-chars-or-app-will-refuse-to-start
JWT_ACCESS_TTL_HOURS=1
JWT_REFRESH_TTL_DAYS=7
REQUIRE_JWT_FOR_WRITES=true
FRONTEND_ORIGIN=http://localhost:5173

# Hibernate schema strategy — keep "validate" in production; only Flyway
# migrates the schema.  "update" allowed for ad-hoc local development.
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# ---- Bootstrap ADMIN (optional) ---------------------------------------------
# When set, the backend creates an ADMIN user for this wallet at startup so
# someone can sign in via /api/auth/nonce + /api/auth/login and then create
# other privileged accounts.  Leave empty for self-managed local dev.
APP_ADMIN_WALLET=
APP_ADMIN_NAME=System administrator

# Pepper for HMAC-pseudonymising wallet addresses in audit_logs.
# Generate with: openssl rand -base64 32
AUDIT_PEPPER=replace-with-32+-random-chars-or-audit-pseudonyms-degrade

# ---- Blockchain indexer (optional) ------------------------------------------
BLOCKCHAIN_INDEXER_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0xYourDeployedContractAddress
BLOCKCHAIN_INDEXER_START_BLOCK=0

# ---- Frontend (Vite build args) ---------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
