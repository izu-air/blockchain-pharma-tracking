# PostgreSQL (docker-compose)
DB_URL=jdbc:postgresql://localhost:5432/pharma_chain
DB_USER=postgres
DB_PASSWORD=postgres

# Backend
JWT_SECRET=use-a-long-random-secret-in-production
JWT_ACCESS_TTL_HOURS=1
JWT_REFRESH_TTL_DAYS=7
REQUIRE_JWT_FOR_WRITES=true
FRONTEND_ORIGIN=http://localhost:5173

# Blockchain indexer (optional)
BLOCKCHAIN_INDEXER_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0xYourContract
BLOCKCHAIN_INDEXER_START_BLOCK=0
