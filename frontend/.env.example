# --- Smart contract --------------------------------------------------------
VITE_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# --- Backend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# --- Network ---------------------------------------------------------------
# Enforces MetaMask network match.  31337 = Hardhat local.
VITE_CHAIN_ID=31337

# --- Public application URL used in QR codes -------------------------------
# Override window.location.origin so a QR generated on the dev machine
# (http://localhost:5173) embeds a URL that a phone on the same LAN can
# actually open — e.g. http://192.168.1.42:5173 or https://app.example.com.
# Leave blank for pure desktop demos where the same browser scans its own QR.
VITE_PUBLIC_APP_URL=
