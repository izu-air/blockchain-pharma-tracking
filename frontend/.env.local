# Local development overrides — Vite reads this in addition to .env.example.
# Generated automatically after `npx hardhat run scripts/deploy.ts --network localhost`.

# --- Smart contract --------------------------------------------------------
# Адрес SupplyChain, развёрнутого в локальной Hardhat-ноде в этом сеансе.
# Если перезапустишь `npx hardhat node`, пересдеплой и обнови это значение —
# при рестарте ноды состояние теряется и адрес может стать другим.
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Backend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# --- Network ---------------------------------------------------------------
# 31337 — Hardhat local node.  MetaMask должен быть переключён в эту сеть.
VITE_CHAIN_ID=31337

# --- Public application URL used in QR codes -------------------------------
VITE_PUBLIC_APP_URL=
